{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["v", "type", "ts", "content"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "user_message" },
    "ts": { "type": "string", "format": "date-time" },
    "content": { "type": "string" },
    "queue": { "type": "string", "enum": ["steer", "follow"] }
  }
}
