{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["v", "type", "ts", "message"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "type": { "type": "string", "const": "error" },
    "ts": { "type": "string", "format": "date-time" },
    "message": { "type": "string" }
  }
}
