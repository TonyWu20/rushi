use flake
# The reference extension commands, on PATH for direnv shells.
#
# The global `ui_extensions/` layer now needs no PATH export: the
# `mermaid` entry names its binary by a path relative to its own
# entry, and the host resolves that against the entry dir
# (docs/ui-extension.md section 3). The exports below matter for
# the opt-in `ext-rs/` Rust ports, whose manifests keep bare command
# names that resolve on PATH (docs/ui-extension.md section 6).
#
# The binaries are built by `cargo build` in each package
# (scripts/ext-env.sh does the full build). When a target dir is
# absent, the export degrades: the TUI names the missing command at
# start, which is the intended fail-loud path.
[ -d "$PWD/ext-rs/statusline-rs/target/release" ] &&
	export PATH="$PWD/ext-rs/statusline-rs/target/release:$PATH"
[ -d "$PWD/ext-rs/tool_result-rs/target/release" ] &&
	export PATH="$PWD/ext-rs/tool_result-rs/target/release:$PATH"
[ -d "$PWD/ext-rs/notify-rs/target/release" ] &&
	export PATH="$PWD/ext-rs/notify-rs/target/release:$PATH"

# Harness and stage binaries (docs/phase-2-plan.md section 5.1).
# The TUI and `rushi` resolve on PATH.
[ -d "$PWD/target/release" ] &&
	export PATH="$PWD/target/release:$PATH"
