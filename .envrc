use flake
# The `ext-rs/` Rust extension commands moved to the rushi-exts repo at
# the split (docs/tui-ext-repo-split.md section 4, item 9); their PATH
# exports now live in that repo's .envrc. The global `ui_extensions/`
# layer needs no PATH export: the `mermaid` entry names its binary by a
# path relative to its own entry (docs/ui-extension.md section 3).


# Harness and stage binaries (docs/phase-2-plan.md section 5.1).
# The TUI and `rushi` resolve on PATH.
[ -d "$PWD/target/release" ] &&
	export PATH="$PWD/target/release:$PATH"
