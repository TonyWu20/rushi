# The reference extension commands, on PATH for direnv shells.
#
# The TUI resolves extension commands on PATH
# (docs/ui-extension.md section 6). A missing command refuses the
# start: discovery names the manifest and exits (docs/ui-extension.md
# section 3). This .envrc keeps the TUI startable in any direnv shell
# that enters this directory.
#
# The binaries are built by `cargo build` in each package
# (scripts/ext-env.sh does the full build). When a target dir is
# absent, the export degrades: the TUI names the missing command at
# start, which is the intended fail-loud path.
[ -d "$PWD/ui_extensions/mermaid/target/debug" ] &&
	export PATH="$PWD/ui_extensions/mermaid/target/debug:$PATH"
[ -d "$PWD/ext-rs/statusline-rs/target/debug" ] &&
	export PATH="$PWD/ext-rs/statusline-rs/target/debug:$PATH"
[ -d "$PWD/ext-rs/tool_result-rs/target/debug" ] &&
	export PATH="$PWD/ext-rs/tool_result-rs/target/debug:$PATH"
[ -d "$PWD/ext-rs/notify-rs/target/debug" ] &&
	export PATH="$PWD/ext-rs/notify-rs/target/debug:$PATH"

# Harness and stage binaries (docs/phase-2-plan.md section 5.1).
# The TUI and `harness` resolve on PATH.
[ -d "$PWD/target/release" ] &&
	export PATH="$PWD/target/release:$PATH"
